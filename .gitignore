# ==============================================================================
# 1. SENSITIVE FILES & CREDENTIALS (NEVER COMMIT TO GITHUB)
# ==============================================================================
# Environment variable files (contains API keys, DB passwords, secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Allow safe environment example/template files
!.env.example
!.env.template

# Private keys, certificates, and auth credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# API tokens, service accounts, and secret JSONs
*.secret
*.secrets
*.token
*secret*.json
*credential*.json
service-account*.json
google-services.json
GoogleService-Info.plist

# ==============================================================================
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# 3. BUILD OUTPUTS & BUNDLERS
# ==============================================================================
dist/
dist-ssr/
*/dist/
build/
out/
.vite/
*/.vite/
*.tsbuildinfo

# ==============================================================================
# 4. OPERATING SYSTEM & FILE EXPLORER JUNK
# ==============================================================================
# Windows
desktop.ini
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ==============================================================================
# 5. IDE & CODE EDITOR SETTINGS
# ==============================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio / Other editors
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ==============================================================================
# 6. LOGS, CACHES & TEMPORARY FILES
# ==============================================================================
logs/
*.log
.cache/
.parcel-cache/
.eslintcache
*.tmp
*.temp
coverage/
.nyc_output/
